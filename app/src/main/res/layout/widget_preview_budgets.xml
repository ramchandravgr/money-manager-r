<?xml version="1.0" encoding="utf-8"?>
<!-- 3×1 (180×40dp) — category flex; period + fixed % column -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="40dp"
    android:background="@color/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_budget_name_travel"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="9sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="3dp"
        android:background="@color/widget_preview_separator" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:minWidth="36dp"
        android:text="@string/widget_preview_budget_period_custom"
        android:textColor="@color/widget_preview_muted"
        android:textSize="9sp" />

    <View
        android:layout_width="1dp"
        android:layout_height="16dp"
        android:layout_marginHorizontal="3dp"
        android:background="@color/widget_preview_separator" />

    <TextView
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="@string/widget_preview_budget_pct_45"
        android:textColor="@color/widget_preview_on_surface"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
