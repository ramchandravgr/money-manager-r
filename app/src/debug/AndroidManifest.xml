    <application>
        <activity
            android:name="com.rrparallelstudio.miapp.BackupScreenHostActivity"
            android:exported="false" />
        <!-- exported=true so `adb shell am broadcast` (shell UID) can deliver on API 31+. Debug manifest only. -->
