            android:name="com.rrparallelstudio.miapp.debug.MmrCrashlyticsDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.rrparallelstudio.miapp.action.CRASHLYTICS_TEST_CRASH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
